# Audio-Visual Fusion Configuration
# Copy this file to .env and customize as needed
# Reload config at runtime by pressing 'r' key

# ===== Camera Configuration =====
CAMERA_INDEX=0
FRAME_WIDTH=1280
FRAME_HEIGHT=720
CAMERA_FOV=78

# ===== YOLO Model Configuration =====
YOLO_MODEL_PATH=yolov10n.pt
YOLO_CONFIDENCE_THRESHOLD=0.25

# ===== Audio Configuration =====
SOUND_SAMPLE_RATE=16000
SOUND_CHUNK_DURATION=0.1
SOUND_THRESHOLD_DB=-30
MIC_DEVICE_NAME=ReSpeaker

# ===== DOA Configuration =====
DOA_OFFSET=0
DOA_FLIP=True
DOA_SNAP_TOLERANCE=10
DOA_LOCK_TOLERANCE=20

# ===== Tracking Configuration =====
MAX_SOUND_HITS=5
TRACKING_IOU_THRESHOLD=0.5
SOUND_HISTORY_WINDOW=2.0
SOUND_HIT_DEBOUNCE=0.3
TRIGGER_HOLD_TIME=0.5

# ===== Enhancement Features =====
ENABLE_PERFORMANCE_MONITOR=True
ENABLE_AUDIO_HEATMAP=True
HEATMAP_DECAY_RATE=0.95
HEATMAP_INTENSITY=0.3
HEATMAP_BLOB_SIZE_X=80     # Horizontal spread of circular blob (pixels)
HEATMAP_BLOB_SIZE_Y=100    # Vertical spread of circular blob (pixels)

# ===== Logging =====
AUDIO_OVERFLOW_LOG_INTERVAL=10
